{
  // Standalone Next.js config — deliberately does NOT extend tsconfig.node.json
  // (per CLAUDE.md "TypeScript config"): the dashboard is browser/bundler code,
  // so it uses `moduleResolution: bundler` and the Next TS plugin, not Node's
  // nodeNext resolution.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Lets the *.test.ts files import with an explicit .ts extension, which
    // Node's built-in test runner requires under native type stripping. Safe
    // only because `noEmit` is set — nothing here is compiled by tsc.
    "allowImportingTsExtensions": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
