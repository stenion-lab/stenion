{
  "$schema": "https://turborepo.org/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "NODE_ENV",
    "STENION_RPC_URL",
    "STENION_HORIZON_URL",
    "CRON_SECRET",
    "STENION_HEALTH_STALE_MINUTES",
    "STENION_HEALTH_DOWN_MULTIPLIER"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {}
  }
}
